# Configuración del Servidor Noether Auth
PORT=3001

# Supabase Credentials (El Service Role Key es crítico para actualizar contraseñas sin requerir la sesión del usuario)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Frontend URL (Para la redirección en el enlace del correo)
FRONTEND_URL=http://localhost:5173

# Configuración SMTP para Envío de Correos (Dejar en blanco para simular envíos por consola durante desarrollo local)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-contraseña-smtp
SMTP_FROM=Noether SaaS <no-reply@mi-saas.com>
