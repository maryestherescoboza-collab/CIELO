{
  "name": "evaluaci-n-por-competencias",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"vite\" \"npm run dev --prefix server\"",
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --prefix server",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --config vite.web.config.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/mcp-server-supabase": "^0.8.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.1",
    "driver.js": "^1.8.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "lenis": "^1.3.25",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.1",
    "tailwindcss": "^4.2.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.evaluacion.app"
  }
